# MySQL Configuration
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/demo_db
    username: root
    password: password
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
        format_sql: true
  application:
    name: demo-app
    version: 1.0.0
